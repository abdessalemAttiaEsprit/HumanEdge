# Copy this file to .env (gitignored) and fill in real values.
# Used by docker-compose.yml for the backend's SMTP config (OTP emails), JWT signing, and the
# local MySQL root password.

# Gmail address used to send OTP emails.
MAIL_USERNAME=your-address@gmail.com

# Gmail App Password (NOT your regular Gmail password).
# Gmail requires an App Password for SMTP auth since 2022.
# Generate one at: Google Account -> Security -> 2-Step Verification -> App passwords
# (2-Step Verification must be enabled first)
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Signing key for JWTs issued by the backend. Any random string works locally - generate one
# with: openssl rand -base64 48
# Never reuse a value that has ever been committed to git (including this repo's history).
JWT_SECRET=replace-with-your-own-random-value

# Local-only MySQL root password (also used as the backend's DB_PASSWORD). Any value works -
# this container is not meant to be reachable outside your machine.
MYSQL_ROOT_PASSWORD=replace-with-your-own-local-password

# Google Calendar sync (optional - the app works fine without these, the "Connect Google
# Calendar" button just fails with a clear error until configured). To obtain them:
# 1. https://console.cloud.google.com -> select/create a project -> enable the "Google Calendar
#    API" (APIs & Services > Library).
# 2. APIs & Services > OAuth consent screen -> External -> add scope
#    "https://www.googleapis.com/auth/calendar" (needed to create the dedicated "HumanEdge"
#    calendar, not just manage events on existing ones). While in Testing mode, add your own
#    Google account under "Test users" or you won't be able to complete the consent screen.
# 3. APIs & Services > Credentials > Create Credentials > OAuth client ID > Web application.
#    Authorized redirect URIs: http://localhost:8081/api/google/oauth/callback (local),
#    plus your prod backend URL + /api/google/oauth/callback (e.g.
#    https://api.hr.human-edge.dev/api/google/oauth/callback).
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
