# Copy this file to .env (gitignored) and fill in real values.
# Used by docker-compose.yml for the backend's SMTP config (OTP emails), JWT signing, and the
# local MySQL root password.

# Gmail address used to send OTP emails.
MAIL_USERNAME=your-address@gmail.com

# Gmail App Password (NOT your regular Gmail password).
# Gmail requires an App Password for SMTP auth since 2022.
# Generate one at: Google Account -> Security -> 2-Step Verification -> App passwords
# (2-Step Verification must be enabled first)
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Signing key for JWTs issued by the backend. Any random string works locally - generate one
# with: openssl rand -base64 48
# Never reuse a value that has ever been committed to git (including this repo's history).
JWT_SECRET=replace-with-your-own-random-value

# Local-only MySQL root password (also used as the backend's DB_PASSWORD). Any value works -
# this container is not meant to be reachable outside your machine.
MYSQL_ROOT_PASSWORD=replace-with-your-own-local-password
